+gx15_capture_sequence (FpiDeviceGoodixTls *self, gboolean finger)
+{
+  const gint64 gap = GX_SEQ_GAP_US * self->timing_scale / 100;
+  static const guint8 mcu_55[1] = { 0x55 };
+  static const guint8 nav[2] = { 0x01, 0x00 };
+  static const guint8 img[2] = { 0x01, 0x00 };
