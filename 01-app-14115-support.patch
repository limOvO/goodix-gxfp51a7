+/* ------------------------------------------------------------------ */
+/*  Firmware 14115 (GF_ST411SEC_APP_14115, MateBook 13 WRT-WX9)        */
+/*                                                                     */
+/*  This revision changes two things that matter here:                 */
+/*   * the 48-byte PMK is not readable from RAM — 0xF2 only ever        */
+/*     returns a boot-staged factory record (see gx_factory_read_pmk);  */
+/*   * image capture uses fixed FDT zone patterns rather than values    */
+/*     measured on the unit, in a specific order.                      */
+/*  The recipe below is the one validated against this firmware by the  */
+/*  GXFP51A0 bring-up, which shares the ST411 image path.              */
+/* ------------------------------------------------------------------ */
+
+static const guint8 GX15_FDT_BOOT[12] = {
+  0xb2, 0xb2, 0xc2, 0xc2, 0xa7, 0xa7, 0xb6, 0xb6, 0xa6, 0xa6, 0xb6, 0xb6
+};
+static const guint8 GX15_FDT_BACKGROUND[12] = {
+  0x80, 0xb0, 0x80, 0xc0, 0x80, 0xa4, 0x80, 0xb4, 0x80, 0xa3, 0x80, 0xb4
+};
+static const guint8 GX15_FDT_FINGER[12] = {
+  0x80, 0xb1, 0x80, 0xc1, 0x80, 0xa6, 0x80, 0xb6, 0x80, 0xa5, 0x80, 0xb6
+};
+static const guint8 GX15_FDT_CAPTURE_DOWN[12] = {
+  0x80, 0xb2, 0x80, 0xc2, 0x80, 0xa7, 0x80, 0xb6, 0x80, 0xa6, 0x80, 0xb6
+};
+
+/* One recipe step: a payload command (cmd, payload...) sent with the driver's
+ * usual preamble + drain, exactly as the reference implementation does. */
+static void
+gx15_step (FpiDeviceGoodixTls *self, guint8 cmd, const guint8 *payload,
+           gsize plen)
+{
+  guint8 b[32];
+  gsize n = 0;
+
+  b[n++] = cmd;
+  b[n++] = (guint8) (plen + 1);
+  b[n++] = 0;
+  memcpy (b + n, payload, plen);
+  n += plen;
+  b[n] = goodix_body_cksum (b, n);
+  n++;
+
+  {
+    gint64 t0 = g_get_monotonic_time ();
+
+    gx_send_plain_drain (self, b, n);
+    fp_dbg ("chrono cmd=%02x %ld us", cmd,
+            (long) (g_get_monotonic_time () - t0));
+  }
+}
+
+/* FDT command: state selects 0x36 (mode), 0x32 (down) or 0x34 (up). The
+ * 12 zone bytes follow a state byte and a 0x01 marker. */
+static void
+gx15_fdt (FpiDeviceGoodixTls *self, guint8 state, const guint8 zones[12])
+{
+  guint8 payload[14];
+  guint8 cmd = state == 0x0c ? 0x32 : state == 0x0e ? 0x34 : 0x36;
+
+  payload[0] = state;
+  payload[1] = 0x01;
+  memcpy (payload + 2, zones, 12);
+  gx15_step (self, cmd, payload, sizeof payload);
+}
+
+/* Runs the capture recipe for this firmware.
+ *
+ * Measured on this unit (MateBook 13 WRT-WX9, firmware APP_14115), the same
+ * short recipe works for both the background and a finger press:
+ *
+ *     MCU state 0x55
+ *     FDT(0x36, 0x0d, boot zones)   -> configure the scan
+ *     NAV  (0x50)
+ *     FDT(0x36, 0x0d, background zones) -> settle the baseline
+ *     image (0x20)
+ *
+ * The reference driver's separate "finger" recipe (finger-mode zones, a NOP,
+ * an arm via 0x32 then the image) does NOT work on this panel: the part answers
+ * the image request with a 0xD0 TLS-reconnect request and delivers no frame.
+ * That recipe belongs to the 88x80 panel of the GXFP51A0 this unit is not.
+ *
+ * The DAC registers the reference writes from OTP are likewise skipped: this
+ * unit's OTP block is 32 bytes, not the 64-byte layout those values are
+ * derived from, so there is no calibration to apply here. */
+static void
+gx15_capture_sequence (FpiDeviceGoodixTls *self, gboolean finger)
+{
+  const gint64 gap = GX_SEQ_GAP_US * self->timing_scale / 100;
+  static const guint8 mcu_55[1] = { 0x55 };
+  static const guint8 nav[2] = { 0x01, 0x00 };
+  static const guint8 img[2] = { 0x01, 0x00 };
+
+  (void) finger;
+
+  gx15_step (self, 0xae, mcu_55, sizeof mcu_55);        /* query MCU state */
+  g_usleep (gap);
+  gx15_fdt (self, 0x0d, GX15_FDT_BOOT);
+  g_usleep (gap);
+  gx15_step (self, 0x50, nav, sizeof nav);
+  g_usleep (gap);
+  gx15_fdt (self, 0x0d, GX15_FDT_BACKGROUND);
+  g_usleep (gap);
+  gx15_step (self, 0x20, img, sizeof img);              /* get image */
+  g_usleep (gap);
+}
