+/* Firmware 14115 finger probe.
+ *
+ * Same command byte (0x36) as the older path, but the sensor is put in
+ * finger-mode first and answers with SIX zones in a 20-byte reply:
+ *
+ *   body = 0x36 | len16 | 0 | 0 | touchflag | zone0..zone5 (16-bit each) | cksum
+ *
+ * The touch flag at body[5] carries one bit per zone. Both the flag and the
+ * zone levels are used, and the 6 zones are widened to the 12-slot array the
+ * rest of the driver expects by repeating the middle values, so the existing
+ * mean/drop thresholds keep working unchanged. */
+/* Defined with the factory-PMK code further down; gx_tls_session needs them to
+ * recover from a rejected cached key. */
+#define GX15_PMK_LEN 48
+static gboolean gx15_pmk_cache_load (guint8 pmk[GX15_PMK_LEN]);
+static void gx15_pmk_cache_save (const guint8 pmk[GX15_PMK_LEN]);
+static gboolean gx15_factory_pmk (FpiDeviceGoodixTls *self,
+                                  guint8 pmk[GX15_PMK_LEN]);
+
+#define GX15_FDT_ZONES 6
+#define GX15_TOUCH_MIN_ZONES 1
+#define GX15_FDT_ATTEMPTS 3
+#define GX15_FDT_POLLS 40    /* ~400 ms at the 10 ms poll interval */
+
+static int
+gx15_fdt_probe (FpiDeviceGoodixTls *self, int *out12, int *touchflag)
+{
+  guint8 b[32], rx[256], ty;
+  int n, k, attempt;
+  gsize len = 0;
+
+  /* 0x36 state 0x0d with the finger-mode zone pattern, as a payload command. */
+  b[len++] = 0x36;
+  b[len++] = 14 + 1;
+  b[len++] = 0;
+  b[len++] = 0x0d;
+  b[len++] = 0x01;
+  memcpy (b + len, GX15_FDT_FINGER, 12);
+  len += 12;
+  b[len] = goodix_body_cksum (b, len);
+  len++;
+
+  /* FDT manual is idempotent, and a late or stale transaction is recoverable
+   * by reissuing it, so a few bounded retries are safe. The reply can arrive
+   * noticeably later than the ACK (it is the slow path inside the capture
+   * sequence too), so poll for it rather than assuming one fixed delay. */
+  for (attempt = 0; attempt < GX15_FDT_ATTEMPTS; attempt++)
+    {
+      int got = -1;
+
+      while (gx_read_frame (self, &ty, rx, sizeof rx) > 0)
+        ;
+
+      if (!gx_send_plain_raw (self, b, len))
+        continue;
+      g_usleep (15000 * self->timing_scale / 100);
+
+      for (int poll = 0; poll < GX15_FDT_POLLS; poll++)
+        {
+          n = gx_read_frame (self, &ty, rx, sizeof rx);
+          if (n <= 0)
+            {
+              g_usleep (10000 * self->timing_scale / 100);
+              continue;
+            }
+          if (ty != GOODIX_PKT_PLAIN)
+            continue;
+          if (rx[0] == 0xb0)             /* ACK frame: keep reading */
+            continue;
+          if (rx[0] != 0x36 || n < 7 + 2 * GX15_FDT_ZONES)
+            continue;
+          if (rx[n - 1] != goodix_body_cksum (rx, n - 1))
+            continue;
+          if (((guint16) rx[1] | ((guint16) rx[2] << 8)) != (guint16) (n - 3))
+            continue;
+          got = n;
+          break;
+        }
+
+      if (got < 0)
+        continue;
+
+      if (touchflag)
+        *touchflag = rx[5] & 0x3f;
+      for (k = 0; k < 12; k++)
+        {
+          int z = k * GX15_FDT_ZONES / 12;
+
+          out12[k] = rx[7 + 2 * z] | (rx[8 + 2 * z] << 8);
+        }
+      return 0;
+    }
+  return -1;
+}
