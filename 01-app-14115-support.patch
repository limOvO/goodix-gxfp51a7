+/* One recipe step: a payload command (cmd, payload...) sent with the driver's
+ * usual preamble + drain, exactly as the reference implementation does. */
+static void
+gx15_step (FpiDeviceGoodixTls *self, guint8 cmd, const guint8 *payload,
+           gsize plen)
+{
+  guint8 b[32];
+  gsize n = 0;
+
+  b[n++] = cmd;
+  b[n++] = (guint8) (plen + 1);
+  b[n++] = 0;
+  memcpy (b + n, payload, plen);
+  n += plen;
+  b[n] = goodix_body_cksum (b, n);
+  n++;
