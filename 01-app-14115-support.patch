   plain_len += tmp;
 
-  /* plaintext = content || MAC || padding, where every padding byte carries
-   * the padding length and the final byte is that length. */
+  /* plaintext = content || MAC || padding. TLS 1.2 (RFC 5246 6.2.3.2) says
+   * the padding is N+1 bytes that ALL equal N, so a record whose padding has
+   * been tampered with must be rejected.
+   *
+   * Only reading the final byte is not enough: flipping the last *ciphertext*
+   * byte garbles the final block, and if the resulting last byte happens to
+   * name a length that still fits, the (intact) MAC over the content can still
+   * match and a corrupted record is accepted. That is a real, measurable
+   * 1-in-~256 event per tampered record, and it is what made the driver's own
+   * TLS test flake. Verifying every padding byte closes it. */
   pad = (gsize) plain[plain_len - 1] + 1;
   if ((gsize) plain_len < pad + MAC_LEN)
     return -1;
+  for (gsize i = 0; i < pad; i++)
+    if (plain[plain_len - 1 - i] != plain[plain_len - 1])
+      return -1;
   content_len = (gsize) plain_len - pad - MAC_LEN;
   if (content_len > out_cap)
     return -1;
