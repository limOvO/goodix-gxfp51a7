+/* ------------------------------------------------------------------ */
+/*  Factory PMK recovery for firmware 14115                            */
+/*                                                                     */
+/*  On this revision the 48-byte PMK is not sitting in RAM where 0xF2   */
+/*  would find it: every RAM read returns the same boot-staged factory  */
+/*  record instead. That record is the PMK, AES-128-CBC wrapped:        */
+/*                                                                     */
+/*    record = salt(16) || ciphertext(64) || ...                        */
+/*    key    = SHA256(salt || zeros(48) || fallback_seed(16))[:16]      */
+/*    plain  = AES-128-CBC-decrypt(key, iv = salt, ciphertext)          */
+/*             = 00 0d 00 00 00 30 || PMK(48) || ...                    */
+/*                                                                     */
+/*  The read path also corrupts the record's first byte, so it is       */
+/*  recovered by brute force: exactly one value yields that marker and  */
+/*  length. The live TLS handshake is the final validation, so a wrong  */
+/*  candidate simply fails to connect rather than silently "working".   */
+/* ------------------------------------------------------------------ */
+
+#define GX15_FACTORY_SELECTOR 0x08004000u
+#define GX15_FACTORY_READ_LEN 256u
+
+static const guint8 gx15_fallback_seed[16] = {
+  0x5c, 0xba, 0x6e, 0x25, 0x81, 0x95, 0x18, 0xde,
+  0x2d, 0x53, 0xe9, 0x6d, 0xc0, 0x34, 0x7a, 0xb0
+};
+
+/* The recovered PMK is cached: the factory record is only reliably readable at
+ * a clean boot boundary, so re-deriving it on every open would make claim
+ * failures common. The cache lives beside the other driver state, inside
+ * fprintd's writable StateDirectory, and is re-validated by the TLS handshake
+ * every time — a stale or wrong key simply fails to connect. */
+#define GX15_PMK_CACHE "/var/lib/fprint/.goodixtls-pmk"
+
+static gboolean
+gx15_pmk_cache_load (guint8 pmk[GX15_PMK_LEN])
+{
+  g_autofree gchar *data = NULL;
+  gsize len = 0;
+
+  if (!g_file_get_contents (GX15_PMK_CACHE, &data, &len, NULL) ||
+      len != GX15_PMK_LEN)
+    return FALSE;
+  memcpy (pmk, data, GX15_PMK_LEN);
+  return TRUE;
+}
+
+static void
+gx15_pmk_cache_save (const guint8 pmk[GX15_PMK_LEN])
+{
+  if (!g_file_set_contents (GX15_PMK_CACHE, (const gchar *) pmk, GX15_PMK_LEN, NULL))
+    fp_dbg ("14115: could not cache the PMK");
+  else
+    g_chmod (GX15_PMK_CACHE, 0600);
+}
+
+/* Reads the staged factory record and, on success, leaves the decoded PMK in
+ * @pmk. Returns FALSE if the record could not be read or did not decode. */
+static gboolean
+gx15_factory_pmk (FpiDeviceGoodixTls *self, guint8 pmk[GX15_PMK_LEN])
+{
+  guint8 ty, rx[512], pkt[12], staging[512];
+  guint32 a = GX15_FACTORY_SELECTOR - 0x08000000;
+  guint8 key[32], plain[128];
+  EVP_CIPHER_CTX *ctx = NULL;
+  gboolean ok = FALSE;
+  int n = -1, i, hits = 0, attempt;
+  guint8 found = 0, candidate[GX15_PMK_LEN];
+  size_t slen = 0;
+
+  pkt[0] = GOODIX_CMD_MEM_READ;
+  pkt[1] = 9;
+  pkt[2] = 0;
+  pkt[3] = a;
+  pkt[4] = a >> 8;
+  pkt[5] = a >> 16;
+  pkt[6] = a >> 24;
+  pkt[7] = GX15_FACTORY_READ_LEN;
+  pkt[8] = GX15_FACTORY_READ_LEN >> 8;
+  pkt[9] = 0;
+  pkt[10] = 0;
+  pkt[11] = goodix_body_cksum (pkt, 11);
+
+  /* This is the last line of defence for the key, so it retries instead of
+   * giving up on one bad read. A bus left desynchronised by a previous run
+   * (a reply still unread) makes the first attempts useless; draining plus,
+   * from the third attempt, a full reopen of the node clears that. A reset is
+   * deliberately not used: if the key has already been lost, destroying more
+   * state cannot help. */
+  for (attempt = 1; attempt <= 6; attempt++)
+    {
+      while (gx_read_frame (self, &ty, rx, sizeof rx) > 0)
+        ;
+
+      if (attempt >= 3 && self->spi_path)
+        {
+          if (self->spi_fd >= 0)
+            close (self->spi_fd);
+          self->spi_fd = open (self->spi_path, O_RDWR);
+          if (self->spi_fd < 0)
+            return FALSE;
+          {
+            guint8 mode = SPI_MODE_0, bits = 8;
+            guint32 speed = 10000000;
+            ioctl (self->spi_fd, SPI_IOC_WR_MODE, &mode);
+            ioctl (self->spi_fd, SPI_IOC_WR_BITS_PER_WORD, &bits);
+            ioctl (self->spi_fd, SPI_IOC_WR_MAX_SPEED_HZ, &speed);
+          }
+          flock (self->spi_fd, LOCK_EX | LOCK_NB);
+        }
+
+      if (!gx_send_plain_raw (self, pkt, sizeof pkt))
+        continue;
+      g_usleep (12000 * self->timing_scale / 100);
+      gx_read_frame (self, &ty, rx, sizeof rx);         /* ACK */
+      g_usleep (10000 * self->timing_scale / 100);
+      n = gx_read_frame (self, &ty, rx, sizeof rx);
+      if (n <= 12 || rx[0] != GOODIX_CMD_MEM_READ)
+        {
+          fp_dbg ("14115: factory record read attempt %d: n=%d", attempt, n);
+          continue;
+        }
+
+      /* Reply: cmd, len16, addr echo(4), len echo(4), req cksum, record, cksum */
+      if (!(rx[3] == (a & 0xFF) && rx[4] == ((a >> 8) & 0xFF) &&
+            rx[5] == ((a >> 16) & 0xFF) && rx[6] == ((a >> 24) & 0xFF)))
+        {
+          fp_dbg ("14115: factory record reply is not the expected staging form");
+          continue;
+        }
+      slen = (size_t) n - 12;
+      if (slen > sizeof staging)
+        slen = sizeof staging;
+      memcpy (staging, rx + 11, slen);      /* includes the trailing checksum */
+
+      /* The record's first byte is unreliable on this read path, so it is
+       * recovered by brute force: exactly one value must yield the 0x000d
+       * marker and a 48-byte length. */
+      hits = 0;
+      found = 0;
+      for (i = 0; i < 256 && slen >= 16 + 64; i++)
+        {
+          guint8 rec[128];
+          int out1 = 0, out2 = 0;
+
+          memcpy (rec, staging, slen < sizeof rec ? slen : sizeof rec);
+          rec[0] = (guint8) i;
+
+          {
+            guint8 inp[80];
+            unsigned int dl = 0;
+
+            memcpy (inp, rec, 16);
+            memset (inp + 16, 0, 48);
+            memcpy (inp + 64, gx15_fallback_seed, 16);
+            if (EVP_Digest (inp, sizeof inp, key, &dl, EVP_sha256 (), NULL) != 1)
+              break;
+          }
+
+          ctx = EVP_CIPHER_CTX_new ();
+          if (!ctx)
+            break;
+          if (EVP_DecryptInit_ex (ctx, EVP_aes_128_cbc (), NULL, key, rec) == 1 &&
+              EVP_CIPHER_CTX_set_padding (ctx, 0) == 1 &&
+              EVP_DecryptUpdate (ctx, plain, &out1, rec + 16, 64) == 1 &&
+              EVP_DecryptFinal_ex (ctx, plain + out1, &out2) == 1)
+            {
+              if (plain[0] == 0x00 && plain[1] == 0x0d &&
+                  (((guint32) plain[2] << 24) | ((guint32) plain[3] << 16) |
+                   ((guint32) plain[4] << 8) | plain[5]) == GX15_PMK_LEN)
+                {
+                  hits++;
+                  found = (guint8) i;
+                  memcpy (candidate, plain + 6, GX15_PMK_LEN);
+                }
+            }
+          EVP_CIPHER_CTX_free (ctx);
+          ctx = NULL;
+        }
+
+      if (hits == 1)
+        break;
+
+      fp_dbg ("14115: factory record attempt %d gave %d candidates",
+              attempt, hits);
+      g_usleep (20000);
+    }
+
+  if (hits == 1)
+    {
+      memcpy (pmk, candidate, GX15_PMK_LEN);
+      fp_info ("14115: factory PMK recovered (record first byte 0x%02x)", found);
+      ok = TRUE;
+    }
+  else
+    {
+      fp_warn ("14115: factory PMK recovery gave %d candidates (need exactly 1)",
+               hits);
+    }
+
+  memset (key, 0, sizeof key);
+  memset (plain, 0, sizeof plain);
+  memset (candidate, 0, sizeof candidate);
+  return ok;
+}
