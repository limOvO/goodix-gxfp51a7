+/* Waits for the sensor to assert reply-ready. Returns the wait in microseconds,
+ * or -1 when the line is not available or did not assert in time. */
+static gint64
+gx_irq_wait (FpiDeviceGoodixTls *self, int timeout_ms)
+{
+  struct gpio_v2_line_values v = { 0 };
