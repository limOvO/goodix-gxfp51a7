# Build output
stage/
pc-stage/
sources/*/build/

# Toolchain (recreated by toolchain/setup.sh: venv, extracted glib tools)
toolchain/venv/
toolchain/bin/
toolchain/pc/

# Cloned sources (recreated by bootstrap.sh)
sources/
.goodixtls-*

# Compiled helpers and scratch
gx-reset
test-direct
diagnostics/__pycache__/
__pycache__/
*.pyc
*.o
*.so

# Local state
*.log

# NEVER commit biometric data or capture output.
# A stitched fingerprint image reached this repository once by accident: the
# export step copies the working directory wholesale and nothing checked its
# contents. These patterns refuse capture dumps, background frames, adaptive
# stores, score history and any rendered image.
*.png
*.jpg
*.jpeg
*.bin
*.bg
*.pending
*.views
*.scores
# config_pcap.bin is a protocol constant from upstream, not biometric data
!config_pcap.bin
# documentation screenshots, if any are ever added
!docs/**/*.png
